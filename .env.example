# CognoDB Cloud connection (required)
# Get these from https://console.cognodb.com after creating a free c0 instance.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_PASSWORD=<your-generated-password>

# Optional: override default user or database
# COGNODB_USERNAME=cognodb
# COGNODB_DATABASE=neo4j

# API_PORT=8000
